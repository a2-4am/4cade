!cpu 6502
!to "build/PRELAUNCH.INDEXED/CROSSBOW",plain
*=$106

         !source "src/macros.a"

         inc   $3F4
         lda   #$60
         sta   $33F
         jsr   $300
         +ENABLE_ACCEL
         lda   #$60
         sta   $9A1
         lda   #$4C
         sta   $9F4
         lda   #<callback
         sta   $9F4+1
         lda   #>callback
         sta   $9F4+2
         jsr   $800       ; decompress
         lda   #$4C
         sta   $82A0
         sta   $7144
         jsr   $68FD
         +HIDE_ARTWORK
         jsr   $82A3      ; aux move overwrites SHR
         +GET_MACHINE_STATUS_LC_RW
         and   #CHEATS_ENABLED
         beq   +
         lda   #$60
         sta   $7E46      ; no collisions
+
         +DISABLE_ACCEL_LC
         jmp   $7147

callback lda   #$2C
         sta   $829A      ; skip setting reset pwrup byte
         jmp   ($0052)

!if * > PrelaunchMax {
  !error "code is too large, ends at ", *
}
