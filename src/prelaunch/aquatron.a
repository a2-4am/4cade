!cpu 6502
!to "build/PRELAUNCH.INDEXED/AQUATRON",plain
*=$106

    !source "src/macros.a"

         +ENABLE_ACCEL_AND_HIDE_ARTWORK
         lda   #>(callback - 1)
         sta   $5FC3
         lda   #<(callback - 1)
         sta   $5FC6
         jmp   $59C2      ; decompress & show title

callback
         +GET_MACHINE_STATUS_LC_RW
         pha
         and   #HAS_JOYSTICK
         bne   +
         ldx   #2
-        lda   skipjoy, x
         sta   $1F37, x
         dex
         bpl   -
+        pla
         and   #CHEATS_ENABLED
         beq   +
         lda   #$ad
         sta   $7696      ; patch - don't decrease lives
+
         +DISABLE_ACCEL_LC
         jmp   $400

skipjoy  !byte $4C, $87, $1F

!if * > PrelaunchMax {
  !error "code is too large, ends at ", *
}
