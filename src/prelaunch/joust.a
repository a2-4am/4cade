!cpu 6502
!to "build/PRELAUNCH.INDEXED/JOUST",plain
*=$106

    !source "src/macros.a"

         +ENABLE_ACCEL_LC
         lda   #$60
         sta   $74DD
         jsr   $2F27      ; decompress and show title/options screens
         +DISABLE_ACCEL_AND_HIDE_ARTWORK_LC
         jsr   $7000
         +ENABLE_ACCEL_LC
         lda   #>(callback - 1)
         sta   $74F5
         lda   #<(callback - 1)
         sta   $74F8
         jmp   $74E0

callback
         +RESET_VECTOR $100
         lda   #$60
         sta   $B7D1      ; skip reset vector
         lda   #1
         sta   $E0F       ; quit handler patch

         lda   MachineStatus
         and   #CHEATS_ENABLED
         beq   +
         lda   #$ad
         sta   $2bc9
         sta   $2b6b
+
         +DISABLE_ACCEL_LC
         jmp   $A982

!if * > PrelaunchMax {
  !error "code is too large, ends at ", *
}
