!cpu 6502
!to "build/PRELAUNCH.INDEXED/MR",plain
*=$106

         !source "src/macros.a"

         +ENABLE_ACCEL
         lda   #$60
         sta   $084F
         sta   $0897
         jsr   $0800      ; decompress
         +DISABLE_ACCEL_AND_HIDE_ARTWORK
         jsr   $1E00
         +ENABLE_ACCEL_LC
         jsr   $852       ; decompress more
         lda   #$2C
         sta   $13D9      ; reset vector patch
         lda   MachineStatus
         and   #CHEATS_ENABLED
         beq   +
                          ; lives in EF
         lda   #$00
         sta   $777C      ; patch - don't decrease lives
         sta   $78C5      ; patch - don't increase lives

+        +DISABLE_ACCEL_LC
         jmp   $7600

!if * > PrelaunchMax {
  !error "code is too large, ends at ", *
}
